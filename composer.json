{
  "name": "pdro-lucas/filament-ai-writer",
  "description": "AI Writer Action for Filament Forms — supports OpenAI, Claude, Gemini and OpenRouter",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "filament",
    "ai",
    "laravel",
    "openai",
    "claude",
    "gemini",
    "openrouter"
  ],
  "authors": [
    {
      "name": "Pedro Lucas",
      "homepage": "https://github.com/pdro-lucas"
    }
  ],
  "require": {
    "php": "^8.2",
    "filament/filament": "^4.0 || ^5.0",
    "illuminate/support": "^11.28 || ^12.0",
    "illuminate/http": "^11.28 || ^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0",
    "phpunit/phpunit": "^11.5.3"
  },
  "autoload": {
    "psr-4": {
      "PdroLucas\\FilamentAiWriter\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "PdroLucas\\FilamentAiWriter\\FilamentAiWriterServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload-dev": {
    "psr-4": {
      "PdroLucas\\FilamentAiWriter\\Tests\\": "tests/",
      "Workbench\\App\\": "workbench/app/",
      "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
    }
  },
  "scripts": {
    "post-autoload-dump": "@php vendor/bin/testbench package:discover --ansi",
    "workbench:build": "@php vendor/bin/testbench workbench:build --ansi",
    "serve": [
      "Composer\\Config::disableProcessTimeout",
      "@php vendor/bin/testbench serve --host=127.0.0.1 --port=8000"
    ],
    "test": "@php vendor/bin/phpunit"
  }
}
